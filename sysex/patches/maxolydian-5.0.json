 "changes": [
  {
   "id": "lazy-part-apply",
   "source": "tools/patch.s",
   "desc": "Sounding tracks keep their params on pattern change; they apply the destination Part on their first trig."
  },
  {
   "id": "gui-in-transition",
   "source": "tools/patch_gui2.s",
   "desc": "While a track is in transition, the encoders edit the SOURCE Part and update the sound live. v2 adds a reentrancy guard: a nested entry no longer clobbers the single saved return address, which crashed the unit (EXCEPTION VEC:0B)."
  },
  {
   "id": "sticky-scenes-v2",
   "source": "tools/patch_scene2.s",
   "desc": "Scene A/B selection is kept across pattern/Part changes; manual assignment always wins."
  },
  {
   "id": "dirty-track-leds",
   "source": "tools/patch_led.s",
   "desc": "A track still sounding with the source Part's params is lit dimmer (0xF -> 0x5) until it is re-trigged."
  },
  {
   "id": "no-bank-ptn-countdown",
   "source": "in-place: FUN_40056ab8 -> rts",
   "desc": "[BANK] and [PTN] selection windows no longer expire after four seconds. The countdown tick FUN_40056ab8 is turned into an immediate rts. Safe because the whole timer is exclusive to bank/pattern selection: FUN_40059f8c has exactly three callers (SELECT PATTERN, SELECT BANK, BANK n: SELECT PTN) and the tick has one. The press-again-to-exit toggle already existed in stock; closing on a trig press goes through FUN_40056b00, independent of the countdown. The four countdown boxes now stay full, acting as a mode indicator."
  },
  {
   "id": "dirty-scene-trig",
   "source": "tools/patch_trig.s",
   "desc": "The selected scene trig goes amber (both dies) while any track is in transition."
  },
  {
   "id": "boot-branding",
   "source": "ELEK header (-V flag)",
   "desc": "Boot splash and SYSTEM STATUS show MAXOLYDIAN instead of 1.40C."
  }
 ],
